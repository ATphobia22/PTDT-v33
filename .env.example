# =============================================================================
# PTDT / Tri-State Family Engineering System — environment template
# Copy to .env and fill only what you use. MapLibre UI works with NO keys.
# =============================================================================

# --- Optional: Google Gemini (AiPdfAnalyzer / GenAI features) ---
# Leave empty to disable AI features without crashing the rest of the app.
GEMINI_API_KEY=

# --- Optional: Google Maps (@vis.gl/react-google-maps) ---
# Prefer MapLibre (maplibre-gl) for flood layers; set only if you enable Google basemap.
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# --- Optional: public app URL (OAuth / self-links) ---
APP_URL=http://localhost:3000

# --- Node server ---
NODE_ENV=development
PORT=3000

# --- Archimedes engine (Python FastAPI) ---
ARCHIMEDES_HOST=0.0.0.0
ARCHIMEDES_PORT=8000
# Vertical datum must remain NAVD 88 for LOMA / IDNR packages
DEFAULT_VERTICAL_DATUM=NAVD 88

# --- Optional: USGS / external telemetry (read-only public APIs need no key) ---
USGS_GAGE_ID=03378500
