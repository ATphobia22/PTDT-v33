# =============================================================================
# PTDT / Tri-State Family Engineering System — environment template
# Copy to .env and fill only what you use. MapLibre UI works with NO keys.
# =============================================================================

# Optional: Google Gemini (AiPdfAnalyzer). Leave empty to disable AI features.
GEMINI_API_KEY=

# Optional: Google Maps. Prefer MapLibre (maplibre-gl) for flood layers.
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Optional: public app URL
APP_URL=http://localhost:3000

# Node server
NODE_ENV=development
PORT=3000

# Archimedes engine (Python FastAPI)
ARCHIMEDES_HOST=0.0.0.0
ARCHIMEDES_PORT=8000
DEFAULT_VERTICAL_DATUM=NAVD 88

# USGS context gage (public API, no key)
USGS_GAGE_ID=03378500
