# =============================================================================
# Tri-State Family Engineering System — environment template
# Copy to .env and fill ONLY what you use. Default MapLibre UI needs NO keys.
# See docs/API_KEY_MANAGEMENT.md
# =============================================================================

# Optional: Google Gemini (AiPdfAnalyzer). Leave empty to disable.
GEMINI_API_KEY=

# Optional: Google Maps (prefer MapLibre). Never commit real keys.
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Optional: public app URL
APP_URL=http://localhost:3000

# Node server
NODE_ENV=development
PORT=3000

# Archimedes engine (Python FastAPI)
ARCHIMEDES_HOST=0.0.0.0
ARCHIMEDES_PORT=8000
DEFAULT_VERTICAL_DATUM=NAVD 88

# USGS context gages (public API — no key)
USGS_GAGE_ID=03378500
USGS_GAGE_ID_OHIO=03322000

# Optional experimental (Databricks CD only — leave empty for local LOMA path)
# DATABRICKS_HOST=
# DATABRICKS_TOKEN=
