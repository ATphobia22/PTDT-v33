# =============================================================================
# OPTIONAL ONLY — core system runs with ZERO keys
# Government / municipal users: leave everything blank and start the server.
# =============================================================================

# Optional: Gemini chat persona (offline mode works without this)
# GEMINI_API_KEY=

# Optional: public URL when hosted
# APP_URL=

# Optional: override path to a pre-clipped Microsoft buildings GeoJSON
# MS_BUILDINGS_CLIP_URL=/data/buildings/indiana_bonebank_clip.geojson

# Map rendering: MapLibre + OpenStreetMap raster tiles (free) + local GeoJSON
# No Mapbox, no Google Maps key, no Cesium ion token required for core HUD.

# Databricks CD is optional and skipped in CI when secrets are absent.
# DATABRICKS_HOST=
# DATABRICKS_TOKEN=
