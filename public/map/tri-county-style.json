{
  "version": 8,
  "name": "Tri-County River Valley — Engineering Cinematic",
  "sources": {
    "osm": {"type":"vector","url":"mapbox://mapbox.mapbox-streets-v8"},
    "terrain": {"type":"raster-dem","url":"mapbox://mapbox.mapbox-terrain-dem-v1","tileSize":512,"maxzoom":14},
    "imagery": {"type":"raster","tiles":["/api/gis/imagery/{z}/{x}/{y}.jpg"],"tileSize":256},
    "flood": {"type":"vector","tiles":["/api/gis/flood/{z}/{x}/{y}.pbf"],"minzoom":8,"maxzoom":16},
    "assets": {"type":"geojson","data":"/api/gis/assets.geojson"},
    "telemetry": {"type":"geojson","data":"/api/gis/telemetry.geojson"}
  },
  "terrain":{"source":"terrain","exaggeration":1.35},
  "layers":[
    {"id":"imagery","type":"raster","source":"imagery","paint":{"raster-opacity":0.72,"raster-saturation":-0.15}},
    {"id":"water","type":"fill","source":"osm","source-layer":"water","paint":{"fill-color":"#123d4a","fill-opacity":0.82}},
    {"id":"waterway","type":"line","source":"osm","source-layer":"waterway","paint":{"line-color":"#2b8799","line-width":["interpolate",["linear"],["zoom"],6,0.5,12,2,16,5],"line-opacity":0.9}},
    {"id":"flood-100yr","type":"fill","source":"flood","source-layer":"hazard","filter":["==",["get","scenario"],"100year"],"paint":{"fill-color":"#c084fc","fill-opacity":0.16}},
    {"id":"flood-current","type":"fill","source":"flood","source-layer":"hazard","filter":["==",["get","scenario"],"current"],"paint":{"fill-color":"#22d3ee","fill-opacity":0.2}},
    {"id":"roads","type":"line","source":"osm","source-layer":"road","paint":{"line-color":"#64748b","line-width":["interpolate",["linear"],["zoom"],8,0.4,14,2,18,6],"line-opacity":0.65}},
    {"id":"critical-assets","type":"circle","source":"assets","filter":["==",["get","critical"],true],"paint":{"circle-radius":6,"circle-color":"#f59e0b","circle-stroke-color":"#fff","circle-stroke-width":1.5,"circle-opacity":0.95}},
    {"id":"asset-risk","type":"circle","source":"assets","filter":[">",["get","risk"],0.7],"paint":{"circle-radius":["interpolate",["linear"],["get","risk"],0.7,5,1,11],"circle-color":"#ef4444","circle-opacity":0.65,"circle-blur":0.25}},
    {"id":"telemetry","type":"circle","source":"telemetry","paint":{"circle-radius":4,"circle-color":"#34d399","circle-stroke-color":"#022c22","circle-stroke-width":1}},
    {"id":"labels","type":"symbol","source":"osm","source-layer":"place","layout":{"text-field":["coalesce",["get","name_en"],["get","name"]],"text-size":["interpolate",["linear"],["zoom"],7,10,14,15]},"paint":{"text-color":"#e2e8f0","text-halo-color":"#020617","text-halo-width":1.5}}
  ],
  "light":{"anchor":"viewport","color":"#fff4d6","intensity":0.42,"position":[1,210,55]}
