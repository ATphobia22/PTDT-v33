{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ptdt.local/schemas/evidence_manifest.schema.json",
  "title": "PTDT_Local_Evidence_Manifest",
  "description": "Local audit manifest for generated artifacts. Not a federal submission format.",
  "type": "object",
  "properties": {
    "manifest_id": { "type": "string" },
    "timestamp_utc": { "type": "string", "format": "date-time" },
    "simulation_run_id": { "type": "string" },
    "node_anchor": { "type": "string" },
    "navd88_datum_verified": { "type": "boolean" },
    "vertical_datum": { "type": "string", "const": "NAVD 88" },
    "artifacts_generated": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "filename": { "type": "string" },
          "sha256_checksum": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$",
            "description": "Must be hash of real file bytes; empty-string hash e3b0c442... is invalid for evidence"
          }
        },
        "required": ["filename", "sha256_checksum"]
      }
    },
    "authoritative_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_agency": { "type": "string" },
          "file_name": { "type": "string" },
          "sha256_hash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
        },
        "required": ["source_agency", "file_name", "sha256_hash"]
      }
    },
    "master_cryptographic_seal": {
      "type": "object",
      "properties": {
        "hash_algorithm": { "type": "string", "const": "SHA-256" },
        "canonical_hash_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "status": { "type": "string" }
      },
      "required": ["hash_algorithm", "canonical_hash_sha256"]
    }
  },
  "required": ["manifest_id", "timestamp_utc", "navd88_datum_verified", "artifacts_generated"]
}
