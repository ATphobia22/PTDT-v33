{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ATphobia22/PTDT-v33/blob/main/schemas/ptdt_spatial_tile.schema.json",
  "title": "PTDT Spatial Tile",
  "type": "object",
  "required": ["tile_id", "version", "crs", "vertical_datum", "bounds", "confidence", "provenance", "layers"],
  "properties": {
    "tile_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "crs": {"type": "string", "minLength": 1},
    "vertical_datum": {"type": "string", "minLength": 1},
    "epoch": {"type": ["string", "null"]},
    "bounds": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}], "minItems": 4, "maxItems": 4},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "provenance": {
      "type": "object",
      "required": ["sources", "transforms", "content_sha256"],
      "properties": {
        "sources": {"type": "array", "items": {"type": "object", "required": ["source_id", "kind"], "properties": {"source_id": {"type": "string"}, "kind": {"type": "string"}, "uri": {"type": ["string", "null"]}, "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "observed_at": {"type": ["string", "null"]}}, "additionalProperties": false}},
        "transforms": {"type": "array", "items": {"type": "object", "required": ["transform_id", "operation", "input_hashes", "output_hash", "parameters"], "properties": {"transform_id": {"type": "string"}, "operation": {"type": "string"}, "input_hashes": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "output_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "parameters": {"type": "object"}}, "additionalProperties": false}},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "layers": {"type": "object"}
  },
  "additionalProperties": false
}
